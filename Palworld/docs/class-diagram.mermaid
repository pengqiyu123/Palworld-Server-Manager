classDiagram
    %% —— Rust 数据模型（序列化到前端）——
    class WorldInfo {
        +String name
        +String path
        +bool has_level_sav
        +usize player_count
        +u64 size_bytes
        +String source
    }
    class ConfigValue {
        +String name
        +String value
        +String description
        +String field_type
        +Option~f64~ min
        +Option~f64~ max
        +Option~f64~ step
    }
    class PlayerEntry {
        +String player_uid
        +String guid
        +String nickname
        +number level
        +String guild_id
        +number pal_count
        +String last_online
    }

    %% —— Rust 命令/工具层 ——
    class SteamDetect {
        +detect_steam_library_roots() Vec~PathBuf~
        +parse_library_roots(vdf) Vec~String~
        +detect_palserver_path() Vec~String~
    }
    class SaveTransferCommands {
        +discover_worlds() DiscoverResult
        +discover_local_worlds() Vec~WorldInfo~
    }

    %% —— 前端 API 包装层 ——
    class ApiSave {
        +discoverWorlds() DiscoverResult
        +discoverLocalWorlds() Vec~WorldInfo~
    }
    class ApiConfig {
        +getDescriptions() Vec~ConfigValue~
    }
    class ApiSteam {
        +detect() Vec~String~
    }

    %% —— 视图层 ——
    class OverviewView {
        +onDetect()
        +onManual()
        +onStart()
        +onLaunchRadmin()
        +onLaunchGame()
        +onGracefulShutdown()
        +onForceStop()
    }
    class ConfigView {
        +onCopyPw()
        +descriptions: Map~string,string~
    }
    class SaveManagementView {
        +localWorlds: WorldInfo[]
        +serverWorlds: WorldInfo[]
        +expanded: WorldInfo | null
        +onMigrateToServer(w)
    }
    class SaveMigrationView {
        +sourceWorld: string
        +targetWorld: string
        +transferPlayers: string[]
        +onRunMigration()
    }

    %% —— 复用组件 ——
    class InfoTip {
        +html: string
    }
    class PlayerPicker {
        +worldName: string
        +modelValue: string[]
    }
    class TransferSubsetSelector {
        +modelValue: TransferSubset
    }

    SaveTransferCommands ..> WorldInfo : builds(source)
    SteamDetect ..> WorldInfo : roots to scan
    ApiSave ..> WorldInfo : returns
    ApiConfig ..> ConfigValue : returns
    SaveManagementView --> ApiSave : calls
    SaveManagementView --> WorldInfo : render and expand
    SaveMigrationView --> PlayerPicker : left and right columns
    SaveMigrationView --> TransferSubsetSelector : reuse
    ConfigView --> ApiConfig : getDescriptions
    ConfigView --> InfoTip : info tooltip
    OverviewView --> ApiSteam : detect(server)
    OverviewView --> ApiSave : handler reuse
